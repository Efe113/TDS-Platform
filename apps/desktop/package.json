    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.11.2",
    "framer-motion": "^14.6.0",
    "i18next": "^26.5.4",
    "jszip": "^3.10.2",
    "koffi": "^3.3.3",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-i18next": "^17.1.0",

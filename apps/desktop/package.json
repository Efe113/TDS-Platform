{
  "name": "@tds/desktop",
  "version": "0.3.7",
  "private": true,
  "description": "Desktop strategy companion for Roblox Tower Defense Simulator",
  "license": "MIT",
  "author": "Efe113",
  "homepage": "https://github.com/Efe113/TDS-Platform",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "release:win": "electron-vite build && electron-builder --win nsis --publish always",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "rebuild": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@sentry/electron": "^8.3.0",

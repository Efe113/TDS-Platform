{
  "name": "tds-companion",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop strategy companion for Roblox Tower Defense Simulator",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tds/desktop",
    "build": "npm run build -w @tds/desktop",
    "dist": "npm run dist -w @tds/desktop",
    "release:win": "npm run release:win -w @tds/desktop",
    "dist:dir": "npm run dist:dir -w @tds/desktop",
    "test": "npm run test -w @tds/shared",
    "test:watch": "npm run test:watch -w @tds/shared",
    "check:ipc": "node scripts/check-preload-channels.mjs",
    "check:sql": "node scripts/check-sql.mjs",
    "icons": "node scripts/make-icon.mjs",
    "installer:art": "node scripts/make-installer-art.mjs",
    "verify": "npm run check:ipc && npm run check:sql && npm run typecheck && npm run test",
    "typecheck": "npm run typecheck -w @tds/shared && npm run typecheck -w @tds/desktop"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
